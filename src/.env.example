# Bob reasoning boundary: mock | cli | http | manual
BOB_MODE=mock
# cli: Bob Shell headless call; placeholders {mode} {prompt} {prompt_file} (stdin if neither prompt placeholder)
BOB_CMD=bob --chat-mode={mode} -p {prompt}
# http: local adapter contract (see app/bob.py), not an IBM API
BOB_BASE_URL=
BOB_API_KEY=
BOB_MODEL=
BOB_TIMEOUT=180

# Optional AASIST model path
AASIST_MODEL=models/audio/aasist.onnx

# Filled into the victim guide
EMAFIG_UNIT_NAME=
EMAFIG_UNIT_CONTACT=

# API security (token is random per run unless set)
EMAFIG_ALLOWED_HOSTS=127.0.0.1,localhost
EMAFIG_API_TOKEN=
MAX_UPLOAD_MB=2048
